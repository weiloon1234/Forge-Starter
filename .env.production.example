# Local production deploy/build env.
# Copy to .env.production on the machine that runs `make deploy`.
# This file is never uploaded. Server runtime secrets belong in /opt/{APP_ID}/.env.

# Required: private deploy bucket upload + release signing
DEPLOY_BUCKET=team-deployment
DEPLOY_REGION=auto
DEPLOY_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
DEPLOY_ACCESS_KEY_ID=<deploy-writer-access-key-id>
DEPLOY_SECRET_ACCESS_KEY=<deploy-writer-secret-access-key>
DEPLOY_SIGNING_PRIVATE_KEY_PATH=~/.ssh/deploy-signing.key

# Recommended deploy behavior
DEPLOY_RETAIN_RELEASES=5
DEPLOY_DOCKER_CLEANUP=aggressive
DEPLOY_DOCKER_PLATFORM=linux/amd64

# Public frontend build values
VITE_APP_NAME=Forge Starter
VITE_APP_ENV=production
VITE_APP_URL=https://<production-domain>
VITE_API_URL=https://<production-domain>
VITE_WS_URL=wss://<production-domain>/ws
VITE_STORAGE_URL=https://<production-assets-domain>
