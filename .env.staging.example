# =============================================================================
# Staging Environment
# =============================================================================
# Copy to .env.staging on the machine that runs `make deploy`.
#
# scripts/build.sh reads this file locally only:
# - DEPLOY_* selects where artifact zip + VERSION are uploaded.
# - DEPLOY_ACCESS_KEY_ID / DEPLOY_SECRET_ACCESS_KEY authenticate that upload.
# - VITE_* is public and baked into frontend bundles during Docker build.
#
# This file is never uploaded by deploy. Server runtime secrets must be set once
# on the server at /opt/{app}-{environment}/.env.
#
# Server WebSocket hardening also belongs in that runtime .env, not in this
# frontend build file:
# WEBSOCKET__OUTBOUND_BUFFER_SIZE=1024
# WEBSOCKET__ALLOWED_ORIGINS=["https://staging.example.com"]
# WEBSOCKET__HISTORY_BUFFER_SIZE=50

# --- Deploy Artifact Bucket ---
DEPLOY_BUCKET=
DEPLOY_REGION=auto
DEPLOY_ENDPOINT=
DEPLOY_ACCESS_KEY_ID=
DEPLOY_SECRET_ACCESS_KEY=
DEPLOY_RETAIN_RELEASES=5
DEPLOY_DOCKER_CLEANUP=aggressive
DEPLOY_DOCKER_PLATFORM=linux/amd64

# --- Frontend Build-Time Variables (public) ---
VITE_APP_NAME=Forge Starter (Staging)
VITE_APP_ENV=staging
VITE_APP_URL=https://staging.example.com
VITE_API_URL=https://staging.example.com
VITE_WS_URL=wss://staging.example.com/ws
VITE_STORAGE_URL=https://asset-staging.example.com
